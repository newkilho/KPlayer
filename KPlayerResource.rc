list-minus RCDATA "Res/list-minus.png"
ui-html RCDATA "ui/player.html"
ui-css RCDATA "ui/player.css"
icon-cap-close RCDATA "ui/icons/cap-close.svg"
icon-list RCDATA "ui/icons/list.svg"
icon-next RCDATA "ui/icons/next.svg"
icon-pause RCDATA "ui/icons/pause.svg"
icon-pin-off RCDATA "ui/icons/pin-off.svg"
icon-pin RCDATA "ui/icons/pin.svg"
icon-play RCDATA "ui/icons/play.svg"
icon-prev RCDATA "ui/icons/prev.svg"
icon-set RCDATA "ui/icons/set.svg"
icon-sub RCDATA "ui/icons/sub.svg"
icon-vol-off RCDATA "ui/icons/vol-off.svg"
icon-vol-on RCDATA "ui/icons/vol-on.svg"
